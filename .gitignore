# Built client bundle, regenerated by `npm run build` and published inside the
# npm tarball without ever entering git.
/client.js
node_modules/
*.log
*.tgz
.DS_Store

# Local scratch space: benchmark scripts, extracted asar trees, publish notes
# and screenshots never belong in the repository. The glossary and the decision
# records are the tracked parts of .agents.
/.agents/*
!/.agents/CONTEXT.md
!/.agents/docs/
