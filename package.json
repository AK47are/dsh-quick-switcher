{
  "name": "dsh-quick-switcher",
  "version": "1.5.0",
  "private": false,
  "type": "module",
  "description": "One search surface for DeepSeek Harness Web: switch sessions, browse workspaces, run commands, refill input history, jump to main panels, open workspace files, and ask a side question that never enters the main conversation.",
  "license": "MIT",
  "author": "AK47are <54732151+AK47are@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AK47are/dsh-quick-switcher.git"
  },
  "homepage": "https://github.com/AK47are/dsh-quick-switcher#readme",
  "bugs": {
    "url": "https://github.com/AK47are/dsh-quick-switcher/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "quick-switcher",
    "command-palette",
    "search",
    "session"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check",
    "prepare": "node scripts/build.js",
    "test": "node --test tests",
    "market": "node scripts/market-index.js",
    "market:check": "node scripts/market-index.js --check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
    "esbuild": "0.28.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./module": "./module.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "module.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market/index.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
